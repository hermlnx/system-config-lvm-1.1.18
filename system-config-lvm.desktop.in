[Desktop Entry]
Name=Logical Volume Management
GenericName=system-config-lvm
Comment=Configure LVM in a graphical setting
Path=INSTALLDIR/share/system-config-lvm
StartupNotify=true
Icon=INSTALLDIR/share/system-config-lvm/pixmaps/lv_icon.png
Exec=sudo INSTALLDIR/sbin/system-config-lvm
Type=Application
Terminal=true
Categories=System
Keywords=disk;harddrive;partitioning;
